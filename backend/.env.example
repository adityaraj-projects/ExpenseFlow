# Application Configuration
PROJECT_NAME="ExpenseFlow"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (MySQL)
DATABASE_URL="mysql+pymysql://root:your_mysql_password@localhost:3306/expense_flow?charset=utf8mb4"

# Security / JWT Authentication
JWT_SECRET="replace-with-a-secure-random-secret-key-minimum-32-characters"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins (comma separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000"

# Web Push Notifications (VAPID)
# Keys are automatically generated and cached in vapid_keys.json if not provided here.
# For production, specify your own VAPID key pair:
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@expenseflow.local"

# Background Scheduler Security (optional secret header for /api/scheduler/run endpoint)
SCHEDULER_SECRET_KEY=""
